# Sistema de credenciais (snov-am-api) — URL interna em produção (rede docker "ativaai"),
# localhost:8000 (ou o que o docker-compose desse projeto expuser) em dev local.
CREDENTIALS_API_URL=

# API key gerada em POST /api/api-keys no sistema de credenciais (snov-am-api),
# com scopes accounts:read e credentials:read.
CREDENTIALS_API_KEY=

# MySQL de produção — cache de contas/campanhas/listas por squad (db/schema.sql).
# Nunca guarda segredo Snov.io aqui; isso continua só no sistema de credenciais.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
